rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    // Use custom claims for fast role checks (no Firestore read needed)
    function isFaculty() {
      return request.auth != null && (
        request.auth.token.role == 'FACULTY' || 
        request.auth.token.role == 'GTU_ADMIN'
      );
    }
    
    function isAdmin() {
      return request.auth != null && request.auth.token.role == 'GTU_ADMIN';
    }

    // --- Collection Rules ---

    // 1. Users Collection
    // Users can read/write ONLY their own profile, with role immutability.
    match /users/{userId} {
      allow read: if isAuthenticated() && isOwner(userId);
      allow create: if isAuthenticated() && isOwner(userId) && (!('role' in request.resource.data) || request.resource.data.role == 'STUDENT');
      allow update: if isAuthenticated() && isOwner(userId) && (request.resource.data.role == resource.data.role);
      allow delete: if isAuthenticated() && isOwner(userId);
      
      // Tasks Subcollection (Planner)
      match /tasks/{taskId} {
        allow read, write: if isAuthenticated() && isOwner(userId);
      }
    }
    
    // 2. Attendance Records
    // Students can READ (to see their stats).
    // ONLY Faculty/Admin can WRITE (mark attendance).
    match /attendance_records/{recordId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isFaculty();
      allow update, delete: if isAuthenticated() && isFaculty();
    }
    
    // 3. Notices
    // Everyone can READ.
    // ONLY Faculty/Admin can POST.
    match /notices/{noticeId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isFaculty();
      allow update, delete: if isAuthenticated() && isFaculty();
    }
    
    // 4. Resources (Library)
    // Everyone can READ.
    // ONLY Faculty/Admin can UPLOAD/DELETE.
    match /resources/{resourceId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isFaculty();
      allow update, delete: if isAuthenticated() && isFaculty();
    }
    
    // 5. Chats (Social)
    // Participants can read/write messages in their own chats.
    match /chats/{chatId} {
      allow read: if isAuthenticated() && (request.auth.uid in resource.data.participantIds);
      allow create: if isAuthenticated() && (request.auth.uid in request.resource.data.participantIds);
      allow update, delete: if isAuthenticated() && (request.auth.uid in resource.data.participantIds);
      
      match /messages/{messageId} {
        allow read, write: if isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
      }
    }

    // 6. Exam Results
    // Students can READ their own results.
    // ONLY Faculty/Admin can WRITE (grade) results.
    match /exam_results/{resultId} {
      allow read: if isAuthenticated() && (isFaculty() || resource.data.studentId == request.auth.uid);
      allow write: if isAuthenticated() && isFaculty();
    }

    // 7. Official Quizzes
    // Everyone authenticated can READ.
    // ONLY Faculty/Admin can CREATE/UPDATE/DELETE.
    match /official_quizzes/{quizId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isFaculty();
    }

    // 8. GTU Past Papers
    // Everyone authenticated can READ.
    // ONLY Faculty/Admin can UPLOAD/WRITE.
    match /gtu_past_papers/{paperId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isFaculty();
    }

    // 9. Written Evaluations
    // Students can read/write their own evaluations.
    // Faculty/Admin can read/write all evaluations.
    match /written_evaluations/{evalId} {
      allow read: if isAuthenticated() && (isFaculty() || resource.data.studentId == request.auth.uid);
      allow write: if isAuthenticated() && (isFaculty() || request.resource.data.studentId == request.auth.uid);
    }

    // 10. Readiness Indices
    // Students can read/write their own GTU readiness index.
    // Faculty/Admin can read/write all readiness indices.
    match /readiness_indices/{indexId} {
      allow read: if isAuthenticated() && (isFaculty() || resource.data.studentId == request.auth.uid);
      allow write: if isAuthenticated() && (isFaculty() || request.resource.data.studentId == request.auth.uid);
    }

    // 11. Campus Directory
    match /campus_directory/{contactId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isFaculty();
    }

    // 12. Timetables
    match /timetables/{slotId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isFaculty();
    }

    // 13. System Config (License Kill Switch)
    match /system_config/{configId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isAdmin();
    }
  }
}
