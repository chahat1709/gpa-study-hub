{
  "appId": "com.gpashub.app",
  "appName": "GPA Study Hub",
  "webDir": "dist",
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "captureInput": true,
    "allowMixedContent": false
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "backgroundColor": "#0f0a1e",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    }
  }
}
